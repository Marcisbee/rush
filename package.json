{
  "name": "rush-webtest",
  "version": "0.1.0",
  "description": "A persistent WebView-native JavaScript and TypeScript test runner",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Marcisbee/rush.git"
  },
  "homepage": "https://github.com/Marcisbee/rush#readme",
  "bugs": {
    "url": "https://github.com/Marcisbee/rush/issues"
  },
  "keywords": [
    "browser",
    "testing",
    "test-runner",
    "webview"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./internal": {
      "types": "./dist/mock.d.ts",
      "import": "./dist/mock.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "bench": "./bin/rush bench",
    "check": "tsc -p tsconfig.json --noEmit",
    "check:release": "node --test .github/scripts/*.test.mjs",
    "prepack": "tsc -p tsconfig.build.json",
    "test": "make test",
    "test:browser": "make test-browser"
  },
  "dependencies": {
    "@sinonjs/fake-timers": "^15.0.0",
    "@testing-library/dom": "^10.4.1",
    "es-module-lexer": "^2.3.2"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "preact": "^10.27.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^7.0.2"
  }
}
