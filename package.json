{
  "name": "@rush/browser",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./internal": {
      "types": "./dist/mock.d.ts",
      "import": "./dist/mock.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "bench": "./bin/rush bench",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "make test",
    "test:browser": "make test-browser",
    "test:bootstrap": "vitest run",
    "test:bootstrap:watch": "vitest test/bootstrap.test.ts"
  },
  "dependencies": {
    "@sinonjs/fake-timers": "^15.0.0",
    "@testing-library/dom": "^10.4.1",
    "es-module-lexer": "^1.7.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "jsdom": "^26.1.0",
    "preact": "^10.27.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
